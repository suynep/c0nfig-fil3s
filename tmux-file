# remap prefix from 'C-b' to 'C-a'
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# turn on mouse functionality
set -g mouse on

# random ass comment just for checking purposes of the hard link lol

set -sg escape-time 0

# make the status bar transparent
set -g status-style bg=default

# Switch panes with Alt+arrow (no prefix needed)
bind -n M-C-h select-pane -L
bind -n M-C-j select-pane -D
bind -n M-C-k select-pane -U
bind -n M-C-l select-pane -R

# Option 3: prefix + hjkl for resize (one-time prefix press)
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

set-window-option -g window-status-current-style fg=black,bg=cyan
set-window-option -g window-status-style fg=cyan,bg=black

# move the status bar to the top
set-option -g status-position top
set-option -g status-justify centre
set -g status-right ""
set -g status-left ""

set -g allow-passthrough on

set-option -g history-limit 7000
